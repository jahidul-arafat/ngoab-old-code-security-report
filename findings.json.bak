      "remediation": {
        "summary": "Wrap the second dg.php group in the appropriate admin.role middleware matching the least privilege that should see DG form data.",
        "pattern": "Every admin route group carries an explicit role gate; never rely on a sibling group's gate.",
        "code": "Route::middleware(['auth:admin','admin.role:dg'])->group(function(){ /* DGCommonRouteController routes */ });"
      }
